    {
      "id": "soldier_1",
      "preset": "soldier",
      "position": [-6, 0, 5],
      "rotation": 45
    },
    {
      "id": "robot_1",
      "preset": "robot",
      "position": [0, 0, 6],
      "rotation": 180
    }
  ],

  "interactives": [
    {
      "id": "button_1",
      "type": "button",
      "position": [-9.8, 1.2, 0],
      "rotation": 90,
      "color": [0.2, 0.8, 0.2],
      "targetAction": { "type": "showMessage", "params": { "text": "Button pressed!", "duration": 2000 } }
    },
    {
      "id": "key_blue",
      "type": "pickup",
      "position": [5, 0.5, -3],
      "itemType": "key",
      "itemId": "blue_key",
      "color": [0.2, 0.5, 1],
      "size": 0.2
    },
    {
      "id": "health_pack",
      "type": "pickup",
      "position": [-5, 0.5, 4],
      "itemType": "health",
      "amount": 25,
      "respawn": true,
      "respawnTime": 30
    }
  ],

  "triggers": [
    {
      "id": "welcome_trigger",
      "type": "onEnter",
      "volume": { "center": [0, 1.5, -5], "size": [6, 3, 2] },
      "once": true,
      "actions": [
        { "type": "showMessage", "params": { "text": "Welcome to the Procedural Engine Demo!", "duration": 4000 } }
      ]
    },
    {
      "id": "enemy_zone",
      "type": "onEnter",
      "volume": { "center": [5, 1.5, 5], "size": [4, 3, 4] },
      "once": true,
      "actions": [
        { "type": "showMessage", "params": { "text": "Enemy territory!", "duration": 2000 } },
        { "type": "setFlag", "target": "entered_enemy_zone", "params": { "value": true } }
      ]
    }
  ],

  "portals": [
    {
      "id": "exit_portal",
      "wall": "east",
      "rect": { "center": [0, 1.1], "size": [1.6, 2.2] },
      "toRoom": "/rooms/demo2.json",
      "exitPosition": [-5, 0, 0],
      "exitRotation": 90,
      "locked": false
    }
  ],

  "sounds": [
    {
      "id": "ambient",
      "type": "procedural",
      "preset": "ambient_hum",
      "autoplay": true,
      "loop": true,
      "volume": 0.3
    }
  ],

  "playerSpawn": {
    "enabled": true,
    "position": [0, 0, -6],
    "rotation": 0
